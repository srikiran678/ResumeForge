# ResumeForge Environment Variables (InsForge Backend)

# InsForge Public Project API Configuration
VITE_INSFORGE_URL=https://<your-project-id>.ap-southeast.insforge.app
VITE_INSFORGE_KEY=ik_your_insforge_anon_public_key

# InsForge PostgreSQL Direct Database Connection (For Migrations & Server Administration)
DATABASE_URL=postgresql://postgres:<password>@<your-project-id>.ap-southeast.database.insforge.app:5432/insforge?sslmode=require

# Note: Google OAuth Client ID and Secret are configured exclusively in the InsForge Dashboard
# and Google Cloud Console. Never store OAuth Client Secrets in frontend environment files.
